@import url('https://fonts.cdnfonts.com/css/minecrafter');

body {
  margin: 0;
  padding: 0;
  background: url('https://i.pinimg.com/originals/19/d7/14/19d71479920640e6cd75fbd9edfe8dec.gif') center/cover no-repeat fixed;
  font-family: 'Minecrafter', sans-serif;
  cursor: url('https://cur.cursors-4u.net/symbols/sym-1/sym49.cur'), auto;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  flex-direction: column;
}

.container {
  text-align: center;
}

.hint {
  color: #222;
  font-size: 24px;
  margin-bottom: 20px;
  text-shadow: 1px 1px 2px #fff;
}

.vault {
  background: #888;
  padding: 20px;
  border: 4px solid #666;
  display: inline-block;
  border-radius: 8px;
}

.display {
  background: #555;
  color: #ddd;
  font-size: 28px;
  letter-spacing: 4px;
  padding: 10px;
  margin-bottom: 10px;
  border: 3px inset #333;
}

.pad {
  display: grid;
  grid-template-columns: repeat(3, 60px);
  gap: 8px;
  margin-bottom: 10px;
}

.pad button,
.open-btn {
  background: #999;
  color: #222;
  font-size: 20px;
  width: 60px;
  height: 60px;
  border: 3px outset #666;
  font-family: 'Minecrafter', sans-serif;
  cursor: pointer;
}

.open-btn {
  width: 200px;
  margin-top: 10px;
}

.confetti {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: url('https://i.gifer.com/7efs.gif') center/cover no-repeat;
  z-index: 10;
}

.hidden {
  display: none;
}

.surprise {
  margin-top: 20px;
}

.ana-pic {
  width: 180px;
  border: 3px solid #fff;
  border-radius: 8px;
}

.next-btn {
  margin-top: 12px;
  padding: 10px 20px;
  background: #88c;
  color: #fff;
  border-radius: 6px;
  text-decoration: none;
  font-family: 'Minecrafter', sans-serif;
}
