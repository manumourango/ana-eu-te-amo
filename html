<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>site da Ana 🎮💕</title>
  <link href="https://fonts.cdnfonts.com/css/minecrafter" rel="stylesheet">
</head>
<body>
  <div class="container">
    <h2 class="hint">🗝️ o dia que a melhor pessoa do mundo nasceu</h2>
    <div class="vault">
      <div class="display" id="display">------</div>
      <div class="pad">
        <button onclick="press('1')">1</button><button onclick="press('2')">2</button><button onclick="press('3')">3</button>
        <button onclick="press('4')">4</button><button onclick="press('5')">5</button><button onclick="press('6')">6</button>
        <button onclick="press('7')">7</button><button onclick="press('8')">8</button><button onclick="press('9')">9</button>
        <button onclick="backspace()">⌫</button><button onclick="press('0')">0</button><button onclick="clearCode()">C</button>
      </div>
      <button class="open-btn" onclick="openVault()">💗 abrir presente</button>
    </div>
    <div class="confetti hidden" id="confetti"></div>
    <div class="surprise hidden" id="surprise">
      <img src="https://uploaddeimagens.com.br/images/004/833/240/full/anaft.jpg" alt="ana linda" class="ana-pic">
      <audio id="bgMusic" loop>
        <source src="https://example.com/se-tu-me-quiseres.mp3" type="audio/mp3">
      </audio>
      <a href="#" class="next-btn">ir pra parte 2 ✨</a>
    </div>
  </div>
</body>
</html>
